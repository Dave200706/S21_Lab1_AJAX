@model Zombie

<div>
    <h4>Zombie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ShortDesc)
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.ShortDesc)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Point)
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Point)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Force)
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.Force)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ZombieType)
        </dt>
        <dd class="col-sm-7">
            @Html.DisplayFor(model => model.ZombieType.TypeName)
        </dd>
    </dl>
    <a class="detail-btn p-2 border w-100 btn btn-warning px-3" id="@Model.Id"><i class="fa-solid fa-pen-to-square"></i>&nbsp; @Locals["Details"]</a>
</div>
